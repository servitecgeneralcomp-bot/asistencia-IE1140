# Conexión a Postgres (Neon la crea sola al conectarla desde Vercel)
DATABASE_URL=postgres://usuario:clave@host/db?sslmode=require
# Secreto largo y aleatorio (firma de los QR). ¡No lo cambies después o los carnets dejarán de servir!
APP_SECRET=cambia-esto-por-64-caracteres-aleatorios
# Clave para crear el primer administrador en /setup (solo funciona si no hay usuarios)
ADMIN_SETUP_KEY=una-clave-temporal
# Correo con Resend (recomendado)
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM="I.E. 1140 Asistencia <asistencia@tu-dominio.edu.pe>"
# Opcional: a dónde llegan las respuestas de los apoderados (p. ej. correo del colegio)
MAIL_REPLY_TO="ieaureliomiroquesada1140@gmail.com"
# Alternativa SMTP (si no hay RESEND_API_KEY). Ej. Gmail con contraseña de aplicación
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Secreto para el cron de Vercel (Vercel lo envía automáticamente si existe)
CRON_SECRET=otro-secreto-aleatorio
# Solo pruebas: MAIL_MODE=log no envía, solo guarda en la bandeja
MAIL_MODE=
